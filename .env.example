# Local development only. Replace values before any shared deployment.
APP_ENV=development
APP_NAME=OfflineTrace
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///./storage_data/offlinetrace.db
STORAGE_DIR=./storage_data
VALIDATOR_DATA_DIR=./validator_data
LOG_LEVEL=INFO
# Generate a fresh random secret locally; never commit the real .env.
APP_SECRET_KEY=replace-with-a-long-random-local-value
